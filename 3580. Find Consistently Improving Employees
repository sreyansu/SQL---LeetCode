WITH ranking AS (
    SELECT
        pr.employee_id,
        e.name,
        pr.rating,
        RANK() OVER (PARTITION BY pr.employee_id ORDER BY pr.review_date DESC) AS rnk
        FROM performance_reviews pr
        JOIN employees e
        ON pr.employee_id = e.employee_id
),
rank_classification AS (
    SELECT
        employee_id,
        name,
        MAX(
            CASE
                WHEN rnk=1 THEN rating
            END 
        )AS latest_rating,
        MAX(
            CASE
                WHEN rnk=2 THEN rating
            END 
        )AS mid_rating,
        MAX(
            CASE
                WHEN rnk=3 THEN rating
            END 
        )AS initial_rating
    FROM ranking
    GROUP BY employee_id, name
)
SELECT
    employee_id,
    name,
    latest_rating - initial_rating AS improvement_score
    FROM rank_classification
    WHERE latest_rating IS NOT NULL
    AND mid_rating IS NOT NULL
    AND initial_rating IS NOT NULL
    AND latest_rating > mid_rating
    AND mid_rating > initial_rating
    ORDER BY improvement_score DESC, name
