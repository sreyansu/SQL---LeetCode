WITH hmw AS(
    SELECT 
        employee_id,
        COUNT(week_number) AS meeting_heavy_weeks
    FROM (
        SELECT 
            employee_id,
            YEARWEEK(meeting_date,1) AS week_number
        FROM meetings
        GROUP BY employee_id, YEARWEEK(meeting_date,1)
        HAVING SUM(duration_hours) > 20
    )s
    GROUP BY employee_id
    HAVING COUNT(week_number) >= 2
)
SELECT e.employee_id,
e.employee_name,
e.department,
hmw.meeting_heavy_weeks
FROM employees e
INNER JOIN hmw
ON e.employee_id = hmw.employee_id
ORDER BY hmw.meeting_heavy_weeks DESC, e.employee_name
