WITH first_half AS (
    SELECT
        d.driver_id,
        d.driver_name,
        AVG(t.distance_km / t.fuel_consumed) AS first_half_avg
    FROM trips t
    JOIN drivers d
        ON d.driver_id = t.driver_id
    WHERE MONTH(trip_date) IN (1,2,3,4,5,6)
    GROUP BY d.driver_id, d.driver_name
),
second_half AS (
    SELECT
        f.driver_id,
        f.driver_name,
        f.first_half_avg,
        AVG(t.distance_km / t.fuel_consumed) AS second_half_avg
    FROM trips t
    JOIN first_half f
        ON t.driver_id = f.driver_id
    WHERE MONTH(trip_date) IN (7,8,9,10,11,12)
    GROUP BY
        f.driver_id,
        f.driver_name,
        f.first_half_avg
)
SELECT
    driver_id,
    driver_name,
    ROUND(first_half_avg, 2) AS first_half_avg,
    ROUND(second_half_avg, 2) AS second_half_avg,
    ROUND(second_half_avg - first_half_avg, 2) AS efficiency_improvement
FROM second_half
WHERE second_half_avg > first_half_avg
ORDER BY efficiency_improvement DESC, driver_name;
